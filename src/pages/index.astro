---
import Layout from '../layouts/Layout.astro';
import App from '../components/App';

const areas = [
	{
		href: '/personagens',
		icon: '🗡️',
		title: 'Fichas de Personagem',
		description: 'Crie e gerencie seus personagens, atributos, perícias e equipamentos.',
	},
	{
		href: '/campanha',
		icon: '🗺️',
		title: 'Campanha',
		description: 'Acompanhe sua campanha e a mesa em que você está jogando.',
	},
	{
		href: '/regras-de-combate',
		icon: '⚔️',
		title: 'Regras de Combate',
		description: 'Consulte as mecânicas de combate e progressão.',
	},
	{
		href: '/regras-de-criacao',
		icon: '🎲',
		title: 'Regras de Criação',
		description: 'Veja as regras para criar e evoluir seu personagem.',
	},
	{
		href: '/glossario',
		icon: '📜',
		title: 'Glossário',
		description: 'Termos, conceitos e referências do universo da campanha.',
	},
	{
		href: '/itens',
		icon: '🧪',
		title: 'Itens de Missão',
		description: 'Catálogo completo de itens disponíveis para operações de campo.',
	},
];
---

<Layout>
	<header class="relative border-b border-border bg-background/80 px-4 py-4 backdrop-blur">
		<div class="mx-auto flex max-w-5xl items-center justify-between">
			<div class="flex items-center gap-2">
				<span class="text-primary">⚡</span>
				<span class="font-display text-sm font-bold tracking-widest text-primary">WYRDCALL</span>
			</div>
			<span class="text-xs uppercase tracking-widest text-muted-foreground">Sistema de mesa de RPG</span>
		</div>
	</header>

	<main class="relative mx-auto flex max-w-5xl flex-col gap-12 px-4 py-16">
		<div class="flex flex-col items-center gap-3 text-center">
			<span class="text-4xl">⚡</span>
			<p class="text-xs uppercase tracking-[0.3em] text-muted-foreground">Campanhas &amp; personagens</p>
			<h1 class="font-display text-4xl font-bold tracking-wide text-foreground sm:text-5xl">Wyrdcall</h1>
			<p class="max-w-md text-sm text-muted-foreground">
				Reúna sua mesa, gerencie campanhas, fichas e consulte as regras — tudo em um só lugar.
			</p>
		</div>

		<div class="grid gap-8 lg:grid-cols-[minmax(0,360px)_1fr] lg:items-start">
			<div class="flex flex-col gap-4">
				<h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Acesso ao sistema</h2>
				<App client:load />
			</div>

			<div class="flex flex-col gap-4">
				<h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Áreas do sistema</h2>
				<div class="grid gap-4 sm:grid-cols-2">
					{
						areas.map((area) => (
							<a
								href={area.href}
								class="group flex flex-col gap-2 rounded-xl bg-card p-5 text-sm ring-1 ring-foreground/10 transition hover:ring-primary/50"
							>
								<span class="text-2xl">{area.icon}</span>
								<span class="font-display font-semibold text-foreground group-hover:text-primary">
									{area.title}
								</span>
								<span class="text-sm text-muted-foreground">{area.description}</span>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</main>

	<footer class="border-t border-border px-4 py-6 text-center text-xs text-muted-foreground">
		Wyrdcall · Uso interno da mesa
	</footer>
</Layout>
