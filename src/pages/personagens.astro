---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Fichas de Personagem · Wyrdcall">
	<header class="relative border-b border-border bg-background/80 px-4 py-4 backdrop-blur">
		<div class="mx-auto flex max-w-5xl items-center justify-between">
			<a href="/" class="flex items-center gap-2">
				<span class="text-primary">⚡</span>
				<span class="font-display text-sm font-bold tracking-widest text-primary">WYRDCALL</span>
			</a>
			<button
				id="sign-out"
				type="button"
				class="rounded-lg border border-border bg-background px-2.5 py-1.5 text-sm transition hover:bg-muted"
			>
				Sair
			</button>
		</div>
	</header>

	<main class="relative mx-auto flex max-w-5xl flex-col gap-8 px-4 py-16">
		<div class="flex flex-col gap-2">
			<p class="text-xs uppercase tracking-[0.3em] text-muted-foreground">Área do jogador</p>
			<h1 class="font-display text-3xl font-bold text-foreground">Fichas de Personagem</h1>
			<p class="text-sm text-muted-foreground">
				Em construção — em breve você poderá criar e gerenciar seus personagens aqui.
			</p>
		</div>

		<div class="flex flex-col items-center gap-3 rounded-2xl border border-dashed border-border bg-card/40 px-6 py-16 text-center">
			<span class="text-3xl">🗡️</span>
			<p class="text-sm text-muted-foreground">Nenhuma ficha disponível ainda.</p>
		</div>
	</main>
</Layout>

<script>
	import { supabase } from '../lib/supabase';

	const { data } = await supabase.auth.getSession();
	if (!data.session) {
		window.location.href = '/';
	}

	document.getElementById('sign-out')?.addEventListener('click', async () => {
		await supabase.auth.signOut();
		window.location.href = '/';
	});
</script>
