---

<Layout title="Glossário · Wyrdcall">
	<InternalHeader active="glossario" redirectIfLoggedOut={false} />

	<main class="relative mx-auto flex max-w-7xl flex-col gap-10 px-4 py-16">
		<div class="flex flex-col gap-2">
			<p class="text-xs uppercase tracking-[0.3em] text-muted-foreground">Sistema d100 — Todos os termos, siglas e mecânicas</p>
			<h1 class="font-display text-3xl font-bold text-foreground">Glossário de Termos &amp; Siglas</h1>
		</div>

		<div class="sticky top-4 z-10">
			<input
				id="glossario-search"
				type="text"
				placeholder="🔎 Buscar termo ou sigla..."
				class="w-full rounded-lg border border-border bg-card/90 px-4 py-2.5 text-sm text-foreground shadow-[0_1px_0_rgba(255,255,255,0.04)_inset,0_8px_24px_-12px_rgba(0,0,0,0.6)] backdrop-blur placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/40"
			/>
		</div>

		<p id="glossario-empty" class="hidden text-sm text-muted-foreground">Nenhum termo encontrado.</p>

		<div id="glossario-content" class="flex flex-col gap-10">
			{
				categories.map((cat) => (
					<section class="glossario-category flex flex-col gap-4" data-cat={cat.key}>
						<h2 class="flex items-center gap-2 font-display text-xl font-semibold text-foreground">
							<span class="icon-badge text-base">{cat.icon}</span>
							{cat.title}
						</h2>
						<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
							{
								cat.entries.map((entry) => (
									<div
										class="glossario-entry panel flex flex-col gap-1.5 p-4"
										data-search={`${entry.term} ${entry.abbr ?? ''} ${entry.def}`.toLowerCase()}
									>
										<div class="flex flex-wrap items-baseline gap-2">
											<strong class="font-display text-sm text-primary">{entry.term}</strong>
											{entry.abbr && <span class="text-xs text-muted-foreground">{entry.abbr}</span>}
										</div>
										<p class="text-sm leading-relaxed text-muted-foreground" set:html={entry.def} />
									</div>
								))
							}
						</div>
					</section>
				))
			}
		</div>
	</main>
</Layout>

<script>
	const input = document.getElementById('glossario-search') as HTMLInputElement | null;
	const empty = document.getElementById('glossario-empty');
	const categoryEls = Array.from(document.querySelectorAll<HTMLElement>('.glossario-category'));

	function filtrarGlossario(query: string) {
		const q = query.trim().toLowerCase();
		let anyVisible = false;

		for (const cat of categoryEls) {
			let catHasVisible = false;
			const entries = cat.querySelectorAll<HTMLElement>('.glossario-entry');
			for (const entry of entries) {
				const match = !q || (entry.dataset.search ?? '').includes(q);
				entry.classList.toggle('hidden', !match);
				if (match) catHasVisible = true;
			}
			cat.classList.toggle('hidden', !catHasVisible);
			if (catHasVisible) anyVisible = true;
		}

		empty?.classList.toggle('hidden', anyVisible);
	}

	input?.addEventListener('input', () => filtrarGlossario(input.value));
</script>
