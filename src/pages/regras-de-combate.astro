	{ nome: 'Regular', condicao: 'Resultado ≤ valor da perícia', exemplo: 'Rolar 31–60', tone: 'text-primary' },
	{ nome: 'Difícil', condicao: 'Resultado ≤ metade da perícia', exemplo: 'Rolar 13–30', tone: 'text-gold' },
	{ nome: 'Extremo', condicao: 'Resultado ≤ um quinto da perícia', exemplo: 'Rolar 02–12', tone: 'text-sky-400' },
	{ nome: 'Crítico', condicao: 'Resultado = 01', exemplo: 'Rolar 01 (sempre)', tone: 'text-rose-400' },
];

const falhas: Nivel[] = [
	{ nome: 'Falha', condicao: 'Resultado > valor da perícia', exemplo: 'Rolar 61–99', tone: 'text-muted-foreground' },
	{ nome: 'Falha Crítica', condicao: 'Resultado = 100', exemplo: 'Rolar 100', tone: 'text-rose-400' },
];

interface GeralCard {
	title: string;
	items: string[];
}

