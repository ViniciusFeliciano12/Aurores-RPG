PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Somente servidor — usada por src/pages/api/delete-account.ts para excluir a conta via Auth Admin API.
# Nunca prefixar com PUBLIC_. Em dev local, coloque também em um arquivo .dev.vars (convenção wrangler).
# Em produção: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
